diff --git a/crates/cortiq-engine/src/gpu_wgpu/d1_attn_coop.comp b/crates/cortiq-engine/src/gpu_wgpu/d1_attn_coop.comp
new file mode 100644
index 0000000..2481f2c
--- /dev/null
+++ b/crates/cortiq-engine/src/gpu_wgpu/d1_attn_coop.comp
@@ -0,0 +1,225 @@
+#version 450
+#extension GL_KHR_cooperative_matrix : require
+#extension GL_KHR_memory_scope_semantics : require
+#extension GL_KHR_shader_subgroup_basic : require
+#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
+#extension GL_EXT_control_flow_attributes : require
+
+// d1 attention on Xe2's 8x16x16 matrix units: the `set` mask (window 0) or
+// causal within a sliding window. A workgroup takes 16 queries of the 4
+// query heads sharing one KV head (64 stacked rows), so every K/V tile is
+// staged once for all four heads; a window layer visits only the key blocks
+// its queries can see. Two exact passes: row max and denominator, then
+// O = softmax(S)·V. Keeping the softmax statistics final before P·V means
+// the accumulators never need the per-row rescale KHR cooperative matrices
+// cannot express.
+layout(local_size_x = 128) in;
+
+layout(std430, set = 0, binding = 0) readonly buffer Q { vec4 q4[]; };
+layout(std430, set = 0, binding = 1) readonly buffer K { vec4 k4[]; };
+layout(std430, set = 0, binding = 2) readonly buffer V { vec4 v4[]; };
+layout(std430, set = 0, binding = 3) buffer O { float o[]; };
+layout(std430, set = 0, binding = 4) readonly buffer G { int grp[]; };
+layout(std140, set = 0, binding = 5) uniform P {
+    uint t;
+    uint nh;
+    uint nkv;
+    uint state;
+    uint r0;
+    float scale;
+    uint window;
+    uint pad1;
+} p;
+
+const uint HD = 128;
+const uint HPG = 4;
+const uint QB = 16;
+const uint ROWS = HPG * QB;
+const uint BC = 32;
+
+shared float16_t Qs[ROWS * HD];
+shared float16_t KVs[BC * HD];
+shared float Ss[ROWS * BC];
+shared float16_t Ps[ROWS * BC];
+shared float rowm[ROWS];
+shared float rowl[ROWS];
+shared int gk[BC];
+
+void stage_kv(uint kb, uint g, bool is_v) {
+    const uint tid = gl_LocalInvocationIndex;
+    for (uint e = tid; e < BC * (HD / 4); e += 128) {
+        const uint key = e / (HD / 4);
+        const uint d4 = e % (HD / 4);
+        const uint j = kb + key;
+        vec4 v = vec4(0.0);
+        if (j < p.t) {
+            const uint idx = (j * p.nkv + g) * (HD / 4) + d4;
+            v = is_v ? v4[idx] : k4[idx];
+        }
+        const uint d = key * HD + d4 * 4;
+        KVs[d] = float16_t(v.x);
+        KVs[d + 1] = float16_t(v.y);
+        KVs[d + 2] = float16_t(v.z);
+        KVs[d + 3] = float16_t(v.w);
+    }
+    if (!is_v) {
+        for (uint e = tid; e < BC; e += 128) {
+            const uint j = kb + e;
+            gk[e] = j < p.t ? grp[j] : 0;
+        }
+    }
+}
+
+void scores(uint sg, uint nsg) {
+    const uint tiles = (ROWS / 8) * (BC / 16);
+    for (uint ti = sg; ti < tiles; ti += nsg) {
+        const uint tm = ti / (BC / 16);
+        const uint tn = ti % (BC / 16);
+        coopmat<float, gl_ScopeSubgroup, 8, 16, gl_MatrixUseAccumulator> acc =
+            coopmat<float, gl_ScopeSubgroup, 8, 16, gl_MatrixUseAccumulator>(0.0);
+        [[unroll]] for (uint d0 = 0; d0 < HD; d0 += 16) {
+            coopmat<float16_t, gl_ScopeSubgroup, 8, 16, gl_MatrixUseA> a;
+            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> b;
+            coopMatLoad(a, Qs, tm * 8 * HD + d0, HD, gl_CooperativeMatrixLayoutRowMajor);
+            coopMatLoad(b, KVs, tn * 16 * HD + d0, HD, gl_CooperativeMatrixLayoutColumnMajor);
+            acc = coopMatMulAdd(a, b, acc);
+        }
+        coopMatStore(acc, Ss, tm * 8 * BC + tn * 16, BC, gl_CooperativeMatrixLayoutRowMajor);
+    }
+}
+
+bool visible(uint i, int gi, uint j, uint c) {
+    if (p.window != 0) {
+        return j < p.t && j <= i && j + p.window > i;
+    }
+    return j < p.t && (i < p.state || j < p.state || gk[c] == gi);
+}
+
+void main() {
+    const uint tid = gl_LocalInvocationIndex;
+    const uint sg = gl_SubgroupID;
+    const uint nsg = gl_NumSubgroups;
+    const uint g = gl_WorkGroupID.y;
+    const uint q0 = p.r0 + gl_WorkGroupID.x * QB;
+
+    for (uint e = tid; e < ROWS * (HD / 4); e += 128) {
+        const uint r = e / (HD / 4);
+        const uint d4 = e % (HD / 4);
+        const uint i = q0 + (r % QB);
+        const uint h = g * HPG + r / QB;
+        vec4 v = vec4(0.0);
+        if (i < p.t) {
+            v = q4[(i * p.nh + h) * (HD / 4) + d4];
+        }
+        const uint d = r * HD + d4 * 4;
+        Qs[d] = float16_t(v.x);
+        Qs[d + 1] = float16_t(v.y);
+        Qs[d + 2] = float16_t(v.z);
+        Qs[d + 3] = float16_t(v.w);
+    }
+    uint my_i = 0;
+    int my_g = 0;
+    if (tid < ROWS) {
+        my_i = q0 + (tid % QB);
+        my_g = grp[min(my_i, p.t - 1)];
+        rowm[tid] = -3.0e38;
+        rowl[tid] = 0.0;
+    }
+    barrier();
+    uint klo = 0;
+    uint khi = p.t;
+    if (p.window != 0) {
+        klo = ((q0 + 1 > p.window ? q0 + 1 - p.window : 0) / BC) * BC;
+        khi = min(p.t, q0 + QB);
+    }
+
+    for (uint kb = klo; kb < khi; kb += BC) {
+        stage_kv(kb, g, false);
+        barrier();
+        scores(sg, nsg);
+        barrier();
+        if (tid < ROWS) {
+            float m = rowm[tid];
+            float l = rowl[tid];
+            for (uint c = 0; c < BC; c++) {
+                if (visible(my_i, my_g, kb + c, c)) {
+                    const float s = Ss[tid * BC + c] * p.scale;
+                    if (s > m) {
+                        l = l * exp(m - s) + 1.0;
+                        m = s;
+                    } else {
+                        l += exp(s - m);
+                    }
+                }
+            }
+            rowm[tid] = m;
+            rowl[tid] = l;
+        }
+        barrier();
+    }
+
+    // The 64x128 output split tile by tile over the subgroups, whatever
+    // width ANV dispatches at (SIMD32 on Xe2: 16 tiles each). A fixed
+    // per-subgroup layout measured slower on the B50.
+    const uint otiles = (ROWS / 8) * (HD / 16);
+    const uint tps = otiles / nsg;
+    coopmat<float, gl_ScopeSubgroup, 8, 16, gl_MatrixUseAccumulator> acc[16];
+    [[unroll]] for (uint i = 0; i < 16; i++) {
+        acc[i] = coopmat<float, gl_ScopeSubgroup, 8, 16, gl_MatrixUseAccumulator>(0.0);
+    }
+
+    for (uint kb = klo; kb < khi; kb += BC) {
+        stage_kv(kb, g, false);
+        barrier();
+        scores(sg, nsg);
+        barrier();
+        for (uint e = tid; e < ROWS * BC; e += 128) {
+            const uint r = e / BC;
+            const uint c = e % BC;
+            const uint i = q0 + (r % QB);
+            const int gi = grp[min(i, p.t - 1)];
+            float pr = 0.0;
+            if (visible(i, gi, kb + c, c)) {
+                pr = exp(Ss[e] * p.scale - rowm[r]) / rowl[r];
+            }
+            Ps[e] = float16_t(pr);
+        }
+        barrier();
+        stage_kv(kb, g, true);
+        barrier();
+        [[unroll]] for (uint i = 0; i < 16; i++) {
+            if (i < tps) {
+                const uint ti = sg + i * nsg;
+                const uint tm = ti / (HD / 16);
+                const uint tn = ti % (HD / 16);
+                [[unroll]] for (uint k0 = 0; k0 < BC; k0 += 16) {
+                    coopmat<float16_t, gl_ScopeSubgroup, 8, 16, gl_MatrixUseA> a;
+                    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> b;
+                    coopMatLoad(a, Ps, tm * 8 * BC + k0, BC, gl_CooperativeMatrixLayoutRowMajor);
+                    coopMatLoad(b, KVs, k0 * HD + tn * 16, HD, gl_CooperativeMatrixLayoutRowMajor);
+                    acc[i] = coopMatMulAdd(a, b, acc[i]);
+                }
+            }
+        }
+        barrier();
+    }
+
+    [[unroll]] for (uint i = 0; i < 16; i++) {
+        if (i < tps) {
+            const uint ti = sg + i * nsg;
+            const uint tm = ti / (HD / 16);
+            const uint tn = ti % (HD / 16);
+            coopMatStore(acc[i], Ss, sg * 128, 16, gl_CooperativeMatrixLayoutRowMajor);
+            subgroupBarrier();
+            for (uint e = gl_SubgroupInvocationID; e < 128; e += gl_SubgroupSize) {
+                const uint rr = tm * 8 + e / 16;
+                const uint qi = q0 + (rr % QB);
+                const uint h = g * HPG + rr / QB;
+                if (qi < p.t) {
+                    o[(qi * p.nh + h) * HD + tn * 16 + (e % 16)] = Ss[sg * 128 + e];
+                }
+            }
+            subgroupBarrier();
+        }
+    }
+}
diff --git a/crates/cortiq-engine/src/gpu_wgpu/d1_q8_dp4a.comp b/crates/cortiq-engine/src/gpu_wgpu/d1_q8_dp4a.comp
new file mode 100644
index 0000000..fa6d9d9
--- /dev/null
+++ b/crates/cortiq-engine/src/gpu_wgpu/d1_q8_dp4a.comp
@@ -0,0 +1,124 @@
+#version 450
+#extension GL_EXT_control_flow_attributes : require
+#extension GL_EXT_integer_dot_product : require
+
+// y[nb][rows] = rowscale[n] * sum_b dx[m][b] * <q[n][b], qx[m][b]>: the
+// q8_2f GEMM as int8 dot products over 32-wide blocks, the arm llama.cpp
+// runs Q8_0 on for Intel GPUs. A workgroup computes BM weight rows by BN
+// tokens; each thread a TM x TN register tile with rows strided by BM / TM
+// and tokens by BN / TN. Defaults: the fastest of a sweep on an Arc Pro B50
+// (Xe2, Mesa ANV) at 7680x2048x3499, 9.8 TFLOPS with the quantize pass.
+#ifndef BM
+#define BM 128
+#endif
+#ifndef BN
+#define BN 128
+#endif
+#ifndef TM
+#define TM 4
+#endif
+#ifndef TN
+#define TN 8
+#endif
+#ifndef NT
+#define NT 512
+#endif
+#ifndef PADW
+#define PADW 1
+#endif
+#ifndef KS
+#define KS 1
+#endif
+
+const uint RS = BM / TM;
+const uint CS = BN / TN;
+const uint LDW = 8 + PADW;
+
+layout(local_size_x = NT) in;
+
+layout(std430, set = 0, binding = 0) readonly buffer Wq { uint wq[]; };
+layout(std430, set = 0, binding = 1) readonly buffer QX { uint qx[]; };
+layout(std430, set = 0, binding = 2) readonly buffer DX { float dx[]; };
+layout(std430, set = 0, binding = 3) writeonly buffer Y { float y[]; };
+layout(std140, set = 0, binding = 4) uniform P { uint cols4; uint rows; uint nb; uint cols; } p;
+
+shared uint As[KS * BM * LDW];
+shared uint Bs[KS * BN * LDW];
+shared float Bd[KS * BN];
+
+void main() {
+    const uint tid = gl_LocalInvocationIndex;
+    const uint n0 = gl_WorkGroupID.x * BM;
+    const uint m0 = gl_WorkGroupID.y * BN;
+    const uint tr = tid % RS;
+    const uint tc = tid / RS;
+    const uint nblk = p.cols / 32;
+    const uint rs0 = (p.rows * p.cols) >> 2;
+
+    float acc[TM][TN];
+    [[unroll]] for (uint i = 0; i < TM; i++) {
+        [[unroll]] for (uint j = 0; j < TN; j++) {
+            acc[i][j] = 0.0;
+        }
+    }
+
+    for (uint kb0 = 0; kb0 < nblk; kb0 += KS) {
+        [[unroll]] for (uint s = 0; s < (KS * BM * 8) / NT; s++) {
+            const uint i = tid + s * NT;
+            const uint r = i / (8 * KS);
+            const uint q = i % (8 * KS);
+            const uint k = q / 8;
+            const uint w = q % 8;
+            As[(k * BM + r) * LDW + w] = kb0 + k < nblk ? wq[(n0 + r) * (p.cols / 4) + (kb0 + k) * 8 + w] : 0u;
+        }
+        [[unroll]] for (uint s = 0; s < (KS * BN * 8) / NT; s++) {
+            const uint i = tid + s * NT;
+            const uint c = i / (8 * KS);
+            const uint q = i % (8 * KS);
+            const uint k = q / 8;
+            const uint w = q % 8;
+            const bool live = m0 + c < p.nb && kb0 + k < nblk;
+            Bs[(k * BN + c) * LDW + w] = live ? qx[((m0 + c) * nblk + kb0 + k) * 8 + w] : 0u;
+            if (w == 0) {
+                Bd[k * BN + c] = live ? dx[(m0 + c) * nblk + kb0 + k] : 0.0;
+            }
+        }
+        barrier();
+        [[unroll]] for (uint k = 0; k < KS; k++) {
+            int a[TM][8];
+            [[unroll]] for (uint i = 0; i < TM; i++) {
+                [[unroll]] for (uint w = 0; w < 8; w++) {
+                    a[i][w] = int(As[(k * BM + tr + i * RS) * LDW + w]);
+                }
+            }
+            [[unroll]] for (uint j = 0; j < TN; j++) {
+                const uint c = tc + j * CS;
+                int b[8];
+                [[unroll]] for (uint w = 0; w < 8; w++) {
+                    b[w] = int(Bs[(k * BN + c) * LDW + w]);
+                }
+                const float d = Bd[k * BN + c];
+                [[unroll]] for (uint i = 0; i < TM; i++) {
+                    int s = 0;
+                    [[unroll]] for (uint w = 0; w < 8; w++) {
+                        s += dotPacked4x8EXT(a[i][w], b[w]);
+                    }
+                    acc[i][j] += float(s) * d;
+                }
+            }
+        }
+        barrier();
+    }
+
+    [[unroll]] for (uint i = 0; i < TM; i++) {
+        const uint r = n0 + tr + i * RS;
+        const vec2 r2 = unpackHalf2x16(wq[rs0 + (r >> 1)]);
+        const float rs = (r & 1) == 0 ? r2.x : r2.y;
+        [[unroll]] for (uint j = 0; j < TN; j++) {
+            const uint c = m0 + tc + j * CS;
+            if (c < p.nb) {
+                y[c * p.rows + r] = acc[i][j] * rs;
+            }
+        }
+    }
+}
diff --git a/crates/cortiq-engine/src/gpu_wgpu/d1_q8_quant.comp b/crates/cortiq-engine/src/gpu_wgpu/d1_q8_quant.comp
new file mode 100644
index 0000000..48089e4
--- /dev/null
+++ b/crates/cortiq-engine/src/gpu_wgpu/d1_q8_quant.comp
@@ -0,0 +1,40 @@
+#version 450
+#extension GL_EXT_control_flow_attributes : require
+
+// x'[m][k] = x[m][k] * colfield[k] of a q8_2f weight, quantized per block of
+// 32 to int8 with one f32 scale: the activation side of the int8 dot-product
+// GEMM (llama.cpp's q8_1 activations, without the sum term the symmetric
+// weight never needs).
+layout(local_size_x = 256) in;
+
+layout(std430, set = 0, binding = 0) readonly buffer Wq { uint wq[]; };
+layout(std430, set = 0, binding = 1) readonly buffer X { vec4 x4[]; };
+layout(std430, set = 0, binding = 2) writeonly buffer QX { uint qx[]; };
+layout(std430, set = 0, binding = 3) writeonly buffer DX { float dx[]; };
+layout(std140, set = 0, binding = 4) uniform P { uint cols4; uint rows; uint nb; uint cols; } p;
+
+void main() {
+    const uint nblk = p.cols / 32;
+    const uint idx = gl_GlobalInvocationID.y * 65535u * 256u + gl_GlobalInvocationID.x;
+    if (idx >= p.nb * nblk) {
+        return;
+    }
+    const uint m = idx / nblk;
+    const uint b = idx % nblk;
+    const uint cs0w = (((p.rows * p.cols) >> 1) + p.rows) >> 1;
+    vec4 v[8];
+    float amax = 0.0;
+    [[unroll]] for (uint i = 0; i < 8; i++) {
+        const uint cw = cs0w + b * 16 + i * 2;
+        const vec4 cf = vec4(unpackHalf2x16(wq[cw]), unpackHalf2x16(wq[cw + 1]));
+        v[i] = x4[m * p.cols4 + b * 8 + i] * cf;
+        amax = max(amax, max(max(abs(v[i].x), abs(v[i].y)), max(abs(v[i].z), abs(v[i].w))));
+    }
+    const float d = amax / 127.0;
+    const float inv = d > 0.0 ? 1.0 / d : 0.0;
+    [[unroll]] for (uint i = 0; i < 8; i++) {
+        const ivec4 q = clamp(ivec4(round(v[i] * inv)), ivec4(-127), ivec4(127));
+        qx[idx * 8 + i] = uint(q.x & 0xff) | (uint(q.y & 0xff) << 8) | (uint(q.z & 0xff) << 16) | (uint(q.w & 0xff) << 24);
+    }
+    dx[idx] = d;
+}
diff --git a/crates/cortiq-engine/src/gpu_wgpu/lfm_set.rs b/crates/cortiq-engine/src/gpu_wgpu/lfm_set.rs
index 3cc9168..5b32262 100644
--- a/crates/cortiq-engine/src/gpu_wgpu/lfm_set.rs
+++ b/crates/cortiq-engine/src/gpu_wgpu/lfm_set.rs
@@ -1,10 +1,10 @@
 //! d1's one-pass forward on wgpu (`pipeline_masked::forward_masked`), the
-//! twin of `gpu_metal::lfm_set`: every layer of an LFM3 stack over the whole
-//! packed row in one submission — the batch graph's q4tp / q8_2f GEMMs, the
-//! short convolution walked over the positions from an empty ring, Q/K norm
-//! + RoPE per row, the `set` attention (or causal within a sliding window)
-//! and the per-head sigmoid gate. The host path ran each projection as its
-//! own submission: ~0.7 s for a 228-token request on an A40.
+//! twin of `gpu_metal::lfm_set`: each layer of an LFM3 stack over the whole
